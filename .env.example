# Copy this file to .env and fill in real values. Never commit .env.

# Any OpenAI-compatible LLM endpoint (/v1/chat/completions) and model id
LLM_URL=http://localhost:8080/v1/chat/completions
MODEL_NAME=

# SearXNG instance (JSON format must be enabled)
SEARXNG_URL=http://localhost:8888/search

# Port the dashboard listens on
PORT=4004

# City used for the weather lookup (geocoded automatically, no API key
# needed). If the wrong city is picked, name it more specifically.
LOCATION_NAME=Fremont, CA
